# Внутренние файлы репозитория не должны отдаваться с сайта.
# Cloudflare Pages публикует рабочее дерево целиком, поэтому исходники
# парсеров, SQL-миграций и документация закрываются редиректом на главную.
# 302, а не 301 — чтобы при необходимости легко откатить.

/docs/* / 302
/docs / 302
/scripts/* / 302
/scripts / 302
/supabase/* / 302
/supabase / 302
/.github/* / 302
/.github / 302
/android-twa/* / 302
/android-signing/* / 302
/opencode.json / 302
