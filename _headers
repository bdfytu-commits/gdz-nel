# Заголовки Cloudflare Pages.
# CSP разрешает только то, что реально используется: Supabase, шрифты,
# fuse.js (cdn.jsdelivr), hCaptcha, Lava-виджет и Web3Forms.
# Если добавляешь новый внешний сервис — добавь его домен сюда, иначе браузер
# заблокирует запрос.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://js.hcaptcha.com https://*.hcaptcha.com https://mc.yandex.ru; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co https://*.hcaptcha.com https://mc.yandex.ru; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.web3forms.com https://*.hcaptcha.com https://mc.yandex.ru; frame-src https://widget.lava.top https://*.lava.top https://*.hcaptcha.com; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; frame-ancestors 'self'; manifest-src 'self'; worker-src 'self'

/assets/*
  Cache-Control: public, max-age=604800

/service-worker.js
  Cache-Control: no-cache

/download/app.apk
  Cache-Control: public, max-age=3600

# исходники и внутренние файлы не индексируются (доступ режется в _redirects)
/docs/*
  X-Robots-Tag: noindex, nofollow

/scripts/*
  X-Robots-Tag: noindex, nofollow

/supabase/*
  X-Robots-Tag: noindex, nofollow
